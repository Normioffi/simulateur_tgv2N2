<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.TGV2N2" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="textFillColor">@color/white</item>
        <item name="background">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="buttonCompat">@style/ButtonEvery</item>

        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Base.Theme.SIAC" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/orange</item>
        <item name="colorSecondary">@color/black</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="Base.Theme.Settings" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorAccent">@color/white</item>
        <item name="buttonCompat">@style/ButtonEvery</item>
        <item name="switchStyle">@style/SettingsSwitch</item>
    </style>

    <style name="SettingsSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="backgroundColor">@color/blue</item>
        <item name="colorContainerChecked">@color/blue</item>
    </style>

    <style name="ButtonEvery" parent="TextAppearance.AppCompat.Widget.Button">
        <item name="backgroundTint">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="textAllCaps">true</item>
    </style>

    <style name="Theme.TGV2N2" parent="Base.Theme.TGV2N2" />

    <style name="Theme.SIAC" parent="Base.Theme.SIAC" />

    <style name="Theme.Settings" parent="Base.Theme.Settings" />
</resources>